<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PZModInspector.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PZModInspector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI for the Steam Web API key in the settings (Windows only, like the whole program). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture=false: otherwise MSBuild reads "it"/"en" in the file name and moves them to satellite assemblies. -->
    <EmbeddedResource Include="Localization\Strings.*.json" LogicalName="PZModInspector.Strings.%(Filename).json" WithCulture="false" />
  </ItemGroup>

</Project>
