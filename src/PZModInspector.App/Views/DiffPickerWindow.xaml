<Window x:Class="PZModInspector.App.Views.DiffPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PZModInspector.App.Localization"
        Title="{l:Loc Diff.Pick.Title}" Icon="/Assets/PZModInspector.ico"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="FileText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{l:Loc Diff.Pick.Hint}" Style="{StaticResource SecondaryText}" Margin="0,4,0,12" />
        <!-- Filled in code: one check per copy, in load order. -->
        <StackPanel x:Name="Copies" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="{l:Loc Diff.Pick.Ok}" IsDefault="True" MinWidth="96" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{l:Loc Settings.Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
