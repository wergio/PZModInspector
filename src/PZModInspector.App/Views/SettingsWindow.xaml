<Window x:Class="PZModInspector.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PZModInspector.App.Localization"
        Title="{l:Loc Settings.Title}" Icon="/Assets/PZModInspector.ico"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="{l:Loc Settings.Language}" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" Margin="0,6,0,18"
                  DisplayMemberPath="Title" SelectedValuePath="Code" />

        <TextBlock Text="{l:Loc Settings.Paths}" FontWeight="SemiBold" />
        <TextBlock Text="{l:Loc Settings.Paths.Hint}" Style="{StaticResource SecondaryText}" Margin="0,2,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{l:Loc Settings.Steam}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SteamBox" />
            <Button Grid.Row="0" Grid.Column="2" Content="{l:Loc Settings.Browse}" Margin="8,0,0,0" Click="BrowseSteam_Click" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamDetected" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,12" />

            <TextBlock Grid.Row="2" Text="{l:Loc Settings.Zomboid}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ZomboidBox" />
            <Button Grid.Row="2" Grid.Column="2" Content="{l:Loc Settings.Browse}" Margin="8,0,0,0" Click="BrowseZomboid_Click" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ZomboidDetected" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,12" />
        </Grid>

        <TextBlock Text="{l:Loc Settings.ApiKey}" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,10">
            <Run Text="{l:Loc Settings.ApiKey.Hint}" />
            <Hyperlink NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="Link_RequestNavigate"><Run Text="{l:Loc Settings.ApiKey.Create}" /></Hyperlink>
        </TextBlock>
        <PasswordBox x:Name="ApiKeyBox" Width="340" HorizontalAlignment="Left" MaxLength="64" />

        <TextBlock Text="{l:Loc Settings.Diff}" FontWeight="SemiBold" Margin="0,18,0,0" />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,10">
            <Run Text="{l:Loc Settings.Diff.Hint}" /><Hyperlink NavigateUri="https://winmerge.org/" RequestNavigate="Link_RequestNavigate">WinMerge</Hyperlink><Run Text="{l:Loc Settings.Diff.Hint.After}" />
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DiffBox" />
            <Button Grid.Column="1" Content="{l:Loc Settings.Browse}" Margin="8,0,0,0" Click="BrowseDiff_Click" />
        </Grid>
        <TextBlock x:Name="DiffDetectedText" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" Visibility="Collapsed">
            <Run x:Name="DiffDetectedRun" />
            <Hyperlink Click="UseDetectedDiff_Click"><Run Text="{l:Loc Settings.Diff.Use}" /></Hyperlink>
        </TextBlock>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{l:Loc Settings.Ok}" IsDefault="True" MinWidth="96" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{l:Loc Settings.Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
