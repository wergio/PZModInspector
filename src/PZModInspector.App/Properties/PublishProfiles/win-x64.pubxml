<Project>
  <!-- dotnet publish src/PZModInspector.App -p:PublishProfile=win-x64
       One small PZModInspector.exe that needs the .NET 10 Desktop Runtime installed.
       For an exe that runs anywhere, add -p:SelfContained=true (about 60 MB). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
