<Project>
  <!-- dotnet publish src/PZModInspector.Cli -p:PublishProfile=win-x64
       One PZModInspectorCLI.exe next to PZModInspector.exe; it needs the .NET 10 runtime installed. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
